# ===================================================
# ملف قالب إعدادات البيئة
# انسخ هذا الملف إلى .env وغيّر القيم
# ===================================================

# JWT Configuration
JWT_SECRET=your-super-secure-random-secret-key-here-change-in-production
JWT_EXPIRES_IN=24h

# Database
MONGO_URI=mongodb://mongo:27017/clinic
# Redis (اختياري - اتركه فارغاً إذا لم تكن تستخدم Redis)
# REDIS_URL=redis://redis:6379

# Upload
UPLOADS_BASE_PATH=uploads
STATIC_PREFIX=/static
MAX_LOGO_SIZE_MB=2

# API
NODE_ENV=production
PORT=3000

# Frontend (Production)
NEXT_PUBLIC_SITE_URL=http://medflowsa.cloud
NEXT_PUBLIC_API_URL=http://medflowsa.cloud/api
VITE_SITE_URL=http://medflowsa.cloud/admin
VITE_API_URL=http://medflowsa.cloud/api
VITE_BASE=/admin/

# Callback URL for Payment Redirects (used by Paylink)
# مع nginx: يجب أن يكون http://your-domain.com/api
# بدون nginx: يجب أن يكون http://your-domain.com:3000
CALLBACK_BASE_URL=http://medflowsa.cloud/api


# App Names
NEXT_PUBLIC_SITE_NAME=Smart Clinic
VITE_SITE_NAME=Admin Dashboard

# Security (Production)
ALLOWED_ORIGINS=https://medflowsa.cloud,https://www.medflowsa.cloud

# Default Admin bootstrap (optional)
DEFAULT_ADMIN_EMAIL=admin@clinic.com
DEFAULT_ADMIN_PASSWORD=change-me-please
# DEFAULT_ADMIN_NAME=System Administrator
# DEFAULT_ADMIN_PHONE=+10000000000

# Encryption Key (للتشفير في قاعدة البيانات)
ENCRYPTION_KEY=your-32-character-encryption-key-change-in-production

# Agora Video Configuration (اختياري - يمكن إدارتها من Admin Dashboard)
# إذا لم تحددها هنا، يمكنك إعدادها من Admin Dashboard
AGORA_APP_ID=your-agora-app-id-here
AGORA_APP_CERTIFICATE=your-agora-app-certificate-here
AGORA_TOKEN_EXPIRATION_TIME=3600
AGORA_ENABLED=true

# Video Session Configuration (للاختبار/التطوير)
# تعطيل قيد 10 دقائق لبدء المكالمة (للاستخدام في الاختبار فقط)
# DISABLE_VIDEO_TIME_CHECK=true

# Firebase Cloud Messaging Configuration
# مسار ملف Service Account Key (نسبي من مجلد clinic-api)
FIREBASE_SERVICE_ACCOUNT_PATH=./clinic-api/config/firebase-service-account.json

# أو يمكنك استخدام Base64 String بدلاً من المسار (للإنتاج)
# FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_encoded_key_here

# Paylink Configuration (Testing Environment)
# للحصول على API credentials الخاصة بك:
# 1. سجّل في https://developer.paylink.sa
# 2. أو استخدم credentials الاختبار الافتراضية أدناه
# 3. للإنتاج: احصل على credentials من https://my.paylink.sa

# Testing Environment URL
PAYLINK_API_URL=https://restpilot.paylink.sa

# API Credentials (استبدلها بـ credentials الخاصة بك)
# Testing credentials (افتراضية):
PAYLINK_API_ID=APP_ID_1123453311
PAYLINK_SECRET_KEY=0662abb5-13c7-38ab-cd12-236e58f43766

# أو استخدم credentials الخاصة بك:
# PAYLINK_API_ID=your-api-id-here
# PAYLINK_SECRET_KEY=your-secret-key-here

# Mode: test (للاختبار) أو live (للإنتاج)
PAYLINK_MODE=test

# Webhook URL (للاستقبال إشعارات الدفع من Paylink)
PAYLINK_WEBHOOK_URL=http://your-domain.com/api/v1/payments/webhook

# Email Configuration (لإرسال OTP لإعادة تعيين كلمة السر)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

