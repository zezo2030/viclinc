# ===================================================
# ملف قالب إعدادات البيئة
# انسخ هذا الملف إلى .env وغيّر القيم
# ===================================================

# JWT Configuration
JWT_SECRET=your-super-secure-random-secret-key-here-change-in-production
JWT_EXPIRES_IN=24h

# Database
MONGO_URI=mongodb://mongo:27017/clinic
# Redis (اختياري - اتركه فارغاً إذا لم تكن تستخدم Redis)
# REDIS_URL=redis://redis:6379

# Upload
UPLOADS_BASE_PATH=uploads
STATIC_PREFIX=/static
MAX_LOGO_SIZE_MB=2

# API
NODE_ENV=production
PORT=3000

# Frontend (Production)
NEXT_PUBLIC_SITE_URL=http://yourdomain.com
NEXT_PUBLIC_API_URL=http://yourdomain.com/api
VITE_SITE_URL=http://yourdomain.com/admin
VITE_API_URL=http://yourdomain.com/api

# App Names
NEXT_PUBLIC_SITE_NAME=Smart Clinic
VITE_SITE_NAME=Admin Dashboard

# Security (Production)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

